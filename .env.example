# VoiceIQ Environment Configuration

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceiq

# Redis Cache & Message Broker (optional for local)
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Choose: "ollama" | "openai" | "gemini"
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Optional API keys (if using cloud LLMs)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Pipeline Settings
AI_OUTPUT_LANGUAGE=VI
AI_PIPELINE_MODE=LLM_ONLY

# Server Configuration
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000

# Mock Tenant ID for Local Development
MOCK_TENANT_ID=00000000-0000-0000-0000-000000000001
